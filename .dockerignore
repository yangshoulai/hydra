# Hydra - Dockerignore Configuration

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation
*.md
!README.md
docs/
specs/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*

# Go
vendor/
*.test
*.out
coverage.out

# Build artifacts (will be rebuilt in container)
/backend/hydra
/frontend/dist/
/backend/static/

# Development files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Environment
.env
.env.*
!.env.example

# Database (should not be in image)
*.db
*.sqlite
*.sqlite3

# Temporary
*.tmp
*.temp
*.bak
*.cache

# Testing
/backend/tests/
/frontend/tests/
coverage/

# Configuration (use env vars or mounts)
config.yaml
config.yml
!config.example.yaml
